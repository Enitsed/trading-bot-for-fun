{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "./src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@scalper/shared": ["../../packages/shared/src"],
      "@scalper/shared/*": ["../../packages/shared/src/*"],
      "@scalper/domain": ["../../packages/domain/src"],
      "@scalper/domain/*": ["../../packages/domain/src/*"],
      "@scalper/bot/application/*": ["application/*"],
      "@scalper/bot/infrastructure/*": ["infrastructure/*"],
      "@scalper/bot/interface/*": ["interface/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
