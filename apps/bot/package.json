{
  "name": "@scalper/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepare": "pnpm run build",
    "dev:live": "tsx --env-file ./.env src/live.ts",
    "dev:backtest": "tsx --env-file ./.env src/backtest.ts",
    "start:live": "node dist/live.js",
    "start:backtest": "node dist/backtest.js"
  },
  "dependencies": {
    "@scalper/shared": "workspace:*",
    "ccxt": "^4.2.99",
    "csv-parse": "^5.5.6",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "pg": "^8.13.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/uuid": "^9.0.7",
    "rimraf": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
